{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imMamdouhaboammar/linkedin-animated-infographics/schemas/demo.schema.json",
  "title": "LinkedIn Animated Infographic Demo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "author",
    "author_url",
    "description",
    "created_with",
    "language",
    "story_type",
    "tags",
    "gif",
    "html",
    "created_at",
    "license",
    "rights_confirmed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "author": {"type": "string", "minLength": 1, "maxLength": 80},
    "author_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/?$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "created_with": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2, "maxLength": 32},
    "story_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
    "gif": {"const": "demo.gif"},
    "html": {"const": "index.html"},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "license": {"type": "string", "minLength": 1, "maxLength": 80},
    "rights_confirmed": {"const": true},
    "source_prompt": {"type": "string", "minLength": 1, "maxLength": 10000},
    "repo_url": {"type": "string", "pattern": "^https://"},
    "notes": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
