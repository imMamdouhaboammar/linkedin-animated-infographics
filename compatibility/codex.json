{
  "schema_version": 3,
  "plugin_name": "linkedin-animated-infographics",
  "plugin_version": "3.3.0",
  "surfaces": ["codex", "chatgpt"],
  "manifests": {
    "openai": ".codex-plugin/plugin.json",
    "claude": ".claude-plugin/plugin.json",
    "openai_marketplace": ".agents/plugins/marketplace.json",
    "claude_marketplace": ".claude-plugin/marketplace.json"
  },
  "distributions": {
    "claude": {
      "skills_root": "skills",
      "agents_root": "agents",
      "execution": "native-worker-graph"
    },
    "openai": {
      "skills_root": "openai-skills",
      "execution": "capability-negotiated-autopilot",
      "sandbox_artifacts": true,
      "side_jobs": true,
      "workspace_agents": "optional",
      "fallbacks": ["tool-rich-sequential", "safe-skill-only"]
    }
  },
  "canonical": {
    "skills_root": "skills",
    "agents_root": "agents",
    "router": "helper/router.json",
    "capabilities": "helper/capabilities.json",
    "quality_gates": "helper/quality-gates.json",
    "artifacts": "helper/artifacts.json",
    "modules": "helper/modules.json",
    "research_gates": "research/capability-notes/gates.json",
    "worker_graph": "architecture/plugin-graph.json",
    "identity_policy": "skills/info-stories/references/asset-source-policy.md",
    "typography_policy": "skills/info-stories/references/typography-direction.md"
  },
  "repo_development": {
    "codex_guide": ".codex/AGENTS.md",
    "codex_config": ".codex/config.toml",
    "real_subagents": true
  },
  "public_submission": {
    "type": "skills-only",
    "skills_root": "openai-skills",
    "metadata": "submission/openai-plugin.json",
    "test_cases": "submission/test-cases.json"
  },
  "parity_invariants": [
    "same-plugin-name",
    "same-release-version",
    "quality-process-parity-not-visual-identity",
    "claude-behavior-regression-protected",
    "openai-self-contained-runtime",
    "capability-negotiation-before-execution",
    "no-fake-tool-or-agent-claims",
    "sandbox-artifact-persistence-when-available",
    "workspace-agents-optional-not-auto-installed",
    "evidence-integrity",
    "verified-identity-source-before-concept",
    "lobe-first-supported-ai-tool-identities",
    "intentional-render-safe-typography",
    "clean-creative-structure",
    "still-before-motion",
    "bounded-visual-repair",
    "verified-svg-mascot-rule"
  ]
}
